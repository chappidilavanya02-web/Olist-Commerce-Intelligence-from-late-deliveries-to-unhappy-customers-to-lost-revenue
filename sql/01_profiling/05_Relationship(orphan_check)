/* 
step 5 : Relationships (orpan Check) 
purpose: check every parent-child relationship in both directions
         Joins silently drop those rows without relation
Results are summarised in docs/data_dictionary.md
*/
use OlistDB;
GO

--1.orderitems -> orders
-- Child rows with no parent
SELECT COUNT(*) AS items_without_order
FROM orderitems oi
LEFT JOIN orders o 
ON o.order_id = oi.order_id
WHERE o.order_id IS NULL;
-- Result: 0 (every item has an order)

-- Parent rows with no children
SELECT COUNT(*) AS orders_without_items
FROM orders o
LEFT JOIN orderitems oi 
ON oi.order_id = o.order_id
WHERE oi.order_id IS NULL;

-- Result: 775 (unavailable 603, canceled 164, created 5, invoiced 2, shipped 1)



