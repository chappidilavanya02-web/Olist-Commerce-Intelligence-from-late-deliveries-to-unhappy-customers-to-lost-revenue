-- 7. products.product_category_name -> category translation table
-- Products whose category is not in the translation table (NULL categories excluded)
SELECT COUNT(*) AS products_category_not_in_translation
FROM products p
LEFT JOIN product_category_name_translation t
       ON t.product_category_name = p.product_category_name
WHERE p.product_category_name IS NOT NULL
  AND t.product_category_name IS NULL;
 
-- Products with a NULL category (a missing value, not a broken link)
SELECT COUNT(*) AS products_with_null_category
FROM products
WHERE product_category_name IS NULL;
 
-- Translation categories not used by any product
SELECT COUNT(*) AS translation_categories_unused
FROM product_category_name_translation t
LEFT JOIN products p ON p.product_category_name = t.product_category_name
WHERE p.product_category_name IS NULL;

---- Result: 13 products, from 2 categories: pc_gamer and portateis_cozinha_e_preparadores_de_alimentos
-- Result: 610 


 
-- 8. zip prefix -> geolocation (many rows per prefix)
-- The subquery gives one row per prefix, so the join cannot multiply rows.
-- Customers whose zip prefix is not in geolocation
SELECT COUNT(*) AS customers_without_geolocation
FROM customers c
LEFT JOIN (SELECT DISTINCT geolocation_zip_code_prefix FROM geolocation) g
       ON g.geolocation_zip_code_prefix = c.customer_zip_code_prefix
WHERE g.geolocation_zip_code_prefix IS NULL;
 
-- Sellers whose zip prefix is not in geolocation
SELECT COUNT(*) AS sellers_without_geolocation
FROM sellers s
LEFT JOIN (SELECT DISTINCT geolocation_zip_code_prefix FROM geolocation) g
       ON g.geolocation_zip_code_prefix = s.seller_zip_code_prefix
WHERE g.geolocation_zip_code_prefix IS NULL;

 --Result: 278 customers
